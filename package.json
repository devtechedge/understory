{
  "name": "understory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A living browser terrarium: a slow micro-forest you plant, tend and return to.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 5220",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4187",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "smoke": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
